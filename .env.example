# Copia este archivo como .env y completa con tus valores reales.
# NUNCA subas el archivo .env real a GitHub.

# Servidor
PORT=3000
NODE_ENV=development

# MySQL (local o Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=suministros_farmacia

# SSL — obligatorio para Aiven y otros servicios en la nube (true/false)
DB_SSL=true

# Ruta opcional al certificado CA descargado de Aiven Console.
# Si no se define, se busca automáticamente en backend/certs/ca.pem
# DB_CA_PATH=/ruta/completa/ca.pem

# Contenido del certificado CA como texto (útil en Render/Railway donde
# no hay archivos: pega ahí el contenido completo del ca.pem)
# DB_CA_CERT=
